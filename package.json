    "main": "app.js",
    "type": "module",
    "scripts": {
        "local": "nodemon -r -L dotenv/config ./src/app.js dotenv_config_path=./.env.local",
        "dev": "node -r dotenv/config ./src/app.js dotenv_config_path=./.env.dev",
        "staging": "node -r dotenv/config ./src/app.js dotenv_config_path=./.env.staging",
        "start": "node -r dotenv/config ./src/app.js dotenv_config_path=./.env.production",
        "build:dev": "docker build -f Dockerfile.dev -t git.inet.co.th:5555/team-olr/olr-wlc:b-wlc-uat-9801 . && docker push git.inet.co.th:5555/team-olr/olr-wlc:b-wlc-uat-9801",
        "build:start": "docker build -f Dockerfile.production -t git.inet.co.th:5555/team-olr/olr-wlc:b-wlc-prod-9811 . && docker push git.inet.co.th:5555/team-olr/olr-wlc:b-wlc-prod-9811"
    },
    "author": "",
