        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-fileupload": "^1.4.0",
        "jsonwebtoken": "^9.0.1",
        "moment-timezone": "^0.5.46",
        "mongodb": "^6.16.0",
        "mongoose": "^8.24.3",
        "mysql2": "^3.6.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    }
